# YouTube Data API v3 — Google Cloud Console
VITE_API_KEY=                    # [obligatoire] Clé API YouTube (pour les appels non-auth)
VITE_OAUTH_CLIENT_ID=            # [obligatoire] Client ID OAuth 2.0 (type: application web)
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/callback  # [obligatoire] URI de redirection

# Langue de l'interface
VITE_DEFAULT_LANGUAGE=fr
